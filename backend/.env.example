# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Authentication & JWT
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-length
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super-secret-refresh-key-minimum-32-chars-length
REFRESH_TOKEN_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=mock-google-client-id
GOOGLE_CLIENT_SECRET=mock-google-client-secret

# Database - MongoDB
MONGODB_URI=mongodb://localhost:27017/p2i_saas

# Redis & Queue - BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Object Storage - AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock-access-key
AWS_SECRET_ACCESS_KEY=mock-secret-key
AWS_S3_BUCKET_NAME=p2i-documents-bucket
STORAGE_PROVIDER=mock # Options: s3, mock

# Vector Database - Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
VECTOR_PROVIDER=mock # Options: qdrant, mock

# LLM Providers
LLM_PROVIDER=mock # Options: mistral, groq, openrouter, mock
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Document AI / OCR
DOCUMENT_AI_PROVIDER=mock # Options: mistral_ocr, vision_fallback, mock
