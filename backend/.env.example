# FlowInVoice — Environment Configuration Template
# Copy this file to .env and configure real values. Never commit .env to version control.

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Authentication & JWT Secrets (Change in production to high-entropy 256-bit keys)
JWT_SECRET=replace-with-a-secure-random-32-char-secret-key-12345
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=replace-with-a-secure-random-32-char-refresh-key-12345
REFRESH_TOKEN_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/p2i_saas

# Redis / QueueManager
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=
REQUIRE_REDIS=false

# AWS Storage & Bedrock AI
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=p2i-documents-bucket
STORAGE_PROVIDER=s3
MODEL_ARN=arn:aws:bedrock:us-east-1:325999881191:inference-profile/us.meta.llama3-1-70b-instruct-v1:0
BEDROCK_MODEL_ARN=arn:aws:bedrock:us-east-1:325999881191:inference-profile/us.meta.llama3-1-70b-instruct-v1:0

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
VECTOR_PROVIDER=qdrant

# Multi-Provider AI LLMs & OCR
LLM_PROVIDER=bedrock
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DOCUMENT_AI_PROVIDER=bedrock
UNCATALOGED_SKU_THRESHOLD=1000
